# International digits only, without +, spaces, or a leading 00.
# This is public configuration embedded in the frontend, not a secret.
VITE_WHATSAPP_NUMBER=

# Public Supabase project configuration for /admin only.
# Use the Project URL and a modern sb_publishable_ key. Never a secret/service-role key.
# Leave both blank to keep the storefront running with administration unconfigured.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
